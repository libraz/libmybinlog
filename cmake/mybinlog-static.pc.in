prefix=${pcfiledir}/@MYBINLOG_PC_PREFIX_FROM_PCDIR@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: mybinlog-static
Description: Decoder for the MySQL and MariaDB binlog wire format (static library)
URL: https://github.com/libraz/libmybinlog
Version: @PROJECT_VERSION@
Libs: ${libdir}/libmybinlog.a -lz
Requires: @MYBINLOG_PC_ZSTD@
Cflags: -I${includedir} -DMYBINLOG_STATIC_DEFINE
