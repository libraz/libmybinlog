prefix=${pcfiledir}/@MYBINLOG_PC_PREFIX_FROM_PCDIR@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: mybinlog
Description: Decoder for the MySQL and MariaDB binlog wire format
URL: https://github.com/libraz/libmybinlog
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lmybinlog
@MYBINLOG_PC_LIBS_PRIVATE@
@MYBINLOG_PC_REQUIRES_PRIVATE@
Cflags: -I${includedir}@MYBINLOG_PC_CFLAGS@
