prefix=${pcfiledir}/@MYBINLOG_PC_PREFIX_FROM_PCDIR@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: mybinlog
Description: Decoder for the MySQL and MariaDB binlog wire format
URL: https://github.com/libraz/libmybinlog
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lmybinlog
Libs.private: -lz
Requires.private: @MYBINLOG_PC_ZSTD@
Cflags: -I${includedir}
