    ["MySQL", "interval", "none"],
    ["MySQL", "multi_uuid", "gno0"],
    ["MySQL", "single", "gno_int64max"],
    ["MySQL", "multi_uuid", "none"],
    ["MySQL", "multi_uuid", "gno_int64max"],
    ["MySQL", "tagged", "none"],
